# Desktop Platform Environment Configuration
# 
# This file contains environment variables specific to the desktop platform
# (accessed via php artisan native:serve for Windows/Mac desktop apps via Electron).
# 
# These values override the base .env file when running in desktop mode.
# Copy this file to .env.desktop and customize for your desktop app.
#
# IMPORTANT: Desktop apps should have IDENTICAL FEATURES to Website (Windows/Mac)
# Desktop is just a packaged version of the web app via Electron, not different functionality.
#
# ── Multi-Port Development Strategy ──────────────────────────────────────────
# When running multiple platform modes simultaneously, each uses a distinct port:
#   Web    (php artisan serve)        → port 8000  (see .env.web.example)
#   Mobile (php artisan native:run)   → port 8001  (see .env.mobile.example)
#   Desktop(php artisan native:serve) → port 8002  (this file)
#
# Start desktop mode:  php artisan native:serve
# The embedded NativePHP HTTP server will listen on port 8002.
# ─────────────────────────────────────────────────────────────────────────────

# ── PHP Binary Configuration ──────────────────────────────────────────────────
# Optional: Override PHP binary path for Electron desktop app
# By default, NativePHP auto-detects PHP from common paths and system PATH.
# Set this if you have multiple PHP versions or non-standard installation.
#
# Examples:
#   Windows XAMPP: NATIVEPHP_PHP_BINARY=C:\xampp\php\php.exe
#   Windows WAMP:  NATIVEPHP_PHP_BINARY=C:\wamp64\bin\php\php83\php.exe
#   Windows Custom: NATIVEPHP_PHP_BINARY=C:\php\php.exe
#   macOS Homebrew: NATIVEPHP_PHP_BINARY=/opt/homebrew/bin/php
#   Linux: NATIVEPHP_PHP_BINARY=/usr/bin/php
#
# NATIVEPHP_PHP_BINARY=C:\xampp\php\php.exe

# ── GPU Hardware Acceleration ─────────────────────────────────────────────────
# Optional: Disable GPU hardware acceleration to prevent crashes
# Enable this if you experience graphics-related crashes on startup.
# The app will use software rendering instead (slightly slower but more stable).
#
# ELECTRON_DISABLE_GPU=true

# ── Auto-Updater Configuration ────────────────────────────────────────────────
# Optional: Disable auto-updater in development mode
# Set to false to prevent update checks during development.
# This is recommended for development to avoid semver validation errors.
#
NATIVEPHP_AUTO_UPDATER=false

# ── App Version Configuration ─────────────────────────────────────────────────
# The app version must be in valid semver format (X.Y.Z or X.Y.Z-suffix).
# DO NOT use "DEBUG" as it will cause electron-updater to reject the version.
# For development, use a version like "1.0.0-dev".
#
# NATIVEPHP_APP_VERSION=1.0.0-dev

# Port for the desktop app server
APP_PORT=8002

# NativePHP embedded HTTP server port (used by NativePHP Electron to serve the app)
NATIVEPHP_HTTP_PORT=8002

# Application URL for desktop platform
# Desktop apps use localhost; port 8002 avoids conflicts with the web (8000) and mobile (8001) servers.
APP_URL=http://localhost:8002

# Session driver for desktop platform
# File-based sessions work well for single-user desktop apps
SESSION_DRIVER=file

# Session lifetime (in minutes)
# Desktop sessions can be very long-lived since it's a local app
SESSION_LIFETIME=43200

# Cache driver for desktop platform
# File cache is ideal for desktop applications
CACHE_DRIVER=file

# Queue connection for desktop platform
# Sync is fine for desktop apps (single user, local execution)
QUEUE_CONNECTION=sync

# Broadcasting driver for desktop platform
# Log driver for desktop, or use native notifications
BROADCAST_DRIVER=log

# Filesystem disk for desktop uploads
# Local disk for desktop file storage
# Desktop apps have full filesystem access
FILESYSTEM_DISK=local

# VITE configuration for desktop platform
VITE_PLATFORM=desktop

# Desktop-specific feature flags
# Desktop apps have same features as website but packaged in Electron
DESKTOP_ENABLE_AUTO_UPDATE=true
DESKTOP_ENABLE_SYSTEM_TRAY=true
DESKTOP_ENABLE_NOTIFICATIONS=true
DESKTOP_ENABLE_FILE_SYSTEM=true

# Desktop window configuration
DESKTOP_WINDOW_WIDTH=1200
DESKTOP_WINDOW_HEIGHT=800
DESKTOP_WINDOW_MIN_WIDTH=800
DESKTOP_WINDOW_MIN_HEIGHT=600

# Desktop platform API configuration
API_TIMEOUT=30

# Desktop app version tracking
# Update these when releasing new versions
DESKTOP_APP_VERSION=1.0.0
DESKTOP_MIN_API_VERSION=1.0.0

# Auto-update configuration
# Add your update server URL for desktop app updates
# DESKTOP_UPDATE_SERVER_URL=https://updates.example.com
# DESKTOP_UPDATE_CHECK_INTERVAL=3600

# Desktop analytics
# Add your desktop analytics tracking IDs here
# GOOGLE_ANALYTICS_ID=
# SENTRY_DSN=

# Note: Desktop apps run the same web interface as browsers,
# so they should support the same features (WebRTC, etc.)
# The only difference is the delivery mechanism (Electron wrapper vs browser)
