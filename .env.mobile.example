# Mobile Platform Environment Configuration
# 
# This file contains environment variables specific to the mobile platform
# (accessed via php artisan native:run for Android/iOS native apps).
# 
# These values override the base .env file when running in mobile mode.
# Copy this file to .env.mobile and customize for your mobile app.
#
# ── Multi-Port Development Strategy ──────────────────────────────────────────
# When running multiple platform modes simultaneously, each uses a distinct port:
#   Web    (php artisan serve)        → port 8000  (see .env.web.example)
#   Mobile (php artisan native:run)   → port 8001  (this file)
#   Desktop(php artisan native:serve) → port 8002  (see .env.desktop.example)
#
# Start mobile mode:  php artisan native:run
# The PHP server backing the mobile app will listen on port 8001.
# ─────────────────────────────────────────────────────────────────────────────

# Port for the mobile backend server
APP_PORT=8001

# Native server port (used by NativeServiceProvider for the embedded PHP server)
NATIVE_SERVER_PORT=8001

# Application URL for mobile platform
# 10.0.2.2 is the Android emulator loopback address pointing to the host machine.
# Using port 8001 (dedicated mobile platform port).
# For physical devices, replace with your LAN IP: e.g. http://192.168.1.x:8001
APP_URL=http://10.0.2.2:8001

# Session driver for mobile platform
# Database sessions are more reliable for mobile apps
# They persist across app restarts and work with token-based auth
SESSION_DRIVER=database

# Session lifetime (in minutes)
# Mobile sessions can be longer to reduce login frequency
SESSION_LIFETIME=10080

# Cache driver for mobile platform
# File cache works well for mobile native apps
CACHE_DRIVER=file

# Queue connection for mobile platform
# Database queue for background jobs
QUEUE_CONNECTION=database

# Broadcasting driver for mobile platform
# Use pusher or native push notifications for real-time updates
BROADCAST_DRIVER=pusher

# Filesystem disk for mobile uploads
# Local disk for mobile app storage
# Files can be synced to cloud storage as needed
FILESYSTEM_DISK=local

# VITE configuration for mobile platform
VITE_PLATFORM=mobile

# Mobile-specific feature flags
MOBILE_ENABLE_BIOMETRIC_AUTH=true
MOBILE_ENABLE_PUSH_NOTIFICATIONS=true
MOBILE_ENABLE_OFFLINE_MODE=true
MOBILE_ENABLE_CAMERA_NATIVE=true

# Mobile platform API configuration
# Adjust timeouts for slower mobile networks
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3

# Mobile app version tracking
# Update these when releasing new versions
MOBILE_APP_VERSION=1.0.0
MOBILE_MIN_API_VERSION=1.0.0

# Push notification services
# Add your FCM and APNs credentials here
# FCM_SERVER_KEY=
# FCM_SENDER_ID=
# APNS_CERTIFICATE_PATH=
# APNS_KEY_ID=
# APNS_TEAM_ID=

# Mobile analytics
# Add your mobile analytics tracking IDs here
# FIREBASE_ANALYTICS_ID=
# MIXPANEL_TOKEN=
